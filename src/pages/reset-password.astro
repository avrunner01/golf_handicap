---
---
<main>
  <section id="request-panel">
    <h1>Forgot password?</h1>
    <p>Enter your email to receive a password reset link.</p>
    <form id="request-form">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
      <button type="submit">Send reset link</button>
    </form>
  </section>

  <section id="update-panel" hidden>
    <h1>Choose a new password</h1>
    <form id="new-password">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" minlength="8" required />
      <label for="confirm-password">Confirm new password</label>
      <input id="confirm-password" name="confirmPassword" type="password" minlength="8" required />
      <button type="submit">Update password</button>
    </form>
  </section>

  <p id="message" aria-live="polite"></p>
</main>

<script>
  import { createClient } from '@supabase/supabase-js';

  // Recovery links land on this page carrying a code/access_token; the client
  // auto-exchanges it for a session (detectSessionInUrl), which fires
  // PASSWORD_RECOVERY instead of silently leaving the user "signed in".
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
    { auth: { detectSessionInUrl: true, persistSession: true } }
  );

  const requestPanel = document.querySelector<HTMLElement>('#request-panel');
  const updatePanel = document.querySelector<HTMLElement>('#update-panel');
  const message = document.querySelector<HTMLElement>('#message');
  const showUpdatePanel = () => {
    if (requestPanel) requestPanel.hidden = true;
    if (updatePanel) updatePanel.hidden = false;
  };

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') showUpdatePanel();
  });

  const hashParams = new URLSearchParams(window.location.hash.slice(1));
  const searchParams = new URLSearchParams(window.location.search);

  // Only switch panels for an actual recovery link, not just any existing signed-in session.
  const recoveryLink = hashParams.has('access_token') || searchParams.has('code');

  // Supabase redirects back with error params (not a token) when the link is
  // expired, already used, or was pre-fetched by an email client's link scanner.
  const linkError = hashParams.get('error_description') || searchParams.get('error_description')
    || hashParams.get('error') || searchParams.get('error');

  if (recoveryLink) {
    showUpdatePanel();
  } else if (linkError && message) {
    message.textContent = `${decodeURIComponent(linkError).replace(/\+/g, ' ')} Please request a new reset link below.`;
  }

  document.querySelector<HTMLFormElement>('#request-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const email = new FormData(form).get('email') as string;
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/reset-password`,
    });
    if (message) {
      message.textContent = error
        ? error.message
        : 'Check your email for the password reset link.';
    }
  });

  document.querySelector<HTMLFormElement>('#new-password')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = new FormData(event.currentTarget as HTMLFormElement);
    const password = values.get('password') as string;
    const confirmPassword = values.get('confirmPassword') as string;
    if (password !== confirmPassword) {
      if (message) message.textContent = 'The passwords do not match.';
      return;
    }
    const { error } = await supabase.auth.updateUser({ password });
    if (message) {
      message.textContent = error ? error.message : 'Password updated. Redirecting...';
    }
    if (!error) {
      // Bridge the browser-only session into cookies so the SSR pages recognize it too.
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData?.session;
      if (session) {
        await fetch('/api/auth/set-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_token: session.access_token, refresh_token: session.refresh_token }),
        }).catch(() => {});
      }
      setTimeout(() => { window.location.href = '/dashboard'; }, 1200);
    }
  });
</script>