---
import Layout from '../layouts/Layout.astro';
import sgMail from '@sendgrid/mail';

let statusMessage = '';
let statusType = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const subject = String(data.get('subject') || '').trim();
    const message = String(data.get('message') || '').trim();
    const sendGridApiKey = import.meta.env.SENDGRID_API_KEY || process.env.SENDGRID_API_KEY;
    const contactRecipient = import.meta.env.CONTACT_RECEIVER
      || process.env.CONTACT_RECEIVER
      || import.meta.env.GMAIL_SENDER
      || process.env.GMAIL_SENDER;
    const fromEmail = import.meta.env.SENDGRID_FROM_EMAIL
      || process.env.SENDGRID_FROM_EMAIL
      || contactRecipient;

    if (!name || !email || !message) {
      statusMessage = 'Please fill out all required fields.';
      statusType = 'error';
    } else if (!sendGridApiKey || !contactRecipient || !fromEmail) {
      statusMessage = 'Email service is not configured on the server.';
      statusType = 'error';
    } else {
      sgMail.setApiKey(sendGridApiKey);
      await sgMail.send({
        to: contactRecipient,
        from: fromEmail,
        replyTo: email,
        subject: `[Contact Form] ${subject || 'New message'}`,
        text: [
          `Name: ${name}`,
          `Email: ${email}`,
          `Subject: ${subject || 'New message'}`,
          '',
          'Message:',
          message,
        ].join('\n'),
      });

      statusMessage = 'Thank you for your message! We will get back to you soon.';
      statusType = 'success';
    }
  } catch (error) {
    console.error('Contact email sending failed', error);
    const responseStatus = error && typeof error === 'object'
      ? (error as { response?: { statusCode?: number } }).response?.statusCode
      : undefined;
    statusMessage = responseStatus === 401
      ? 'Email service authentication failed. Please contact the site administrator.'
      : 'An error occurred while sending your message. Please try again.';
    statusType = 'error';
  }
}
---

<Layout title="Contact Us">
  <main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Contact Us</h1>

    {statusMessage && (
      <div class={`p-4 mb-6 rounded ${statusType === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
        {statusMessage}
      </div>
    )}

    <form method="POST" class="space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
        <input
          type="text"
          id="subject"
          name="subject"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-colors font-medium"
      >
        Send Message
      </button>
    </form>
  </main>
</Layout>