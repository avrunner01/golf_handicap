---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabaseClient } from '../lib/supabase';

const supabase = supabaseClient(Astro);

// Get the current session user
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect('/login');
}

// Fetch the pre-calculated handicap from our new table
const { data: handicapData } = await supabase
  .from('user_handicaps')
  .select('current_handicap')
  .eq('profile_id', user.id)
  .single();

const displayHandicap = handicapData?.current_handicap ?? 'NH'; // NH = No Handicap
---

<Layout title="Profile" user={user}>
  <main class="mx-auto w-full max-w-3xl px-6 pb-14">
    <section class="rounded-2xl border border-blue-200 bg-white/80 p-8 shadow-lg backdrop-blur-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-[#2f6f8f]">Profile</p>
      <h1 class="mt-2 text-3xl font-extrabold text-[#1f4f68]">Your Handicap Index</h1>
      <p class="mt-5 text-5xl font-black text-[#18506b]">{displayHandicap}</p>
      <p class="mt-3 text-sm text-[#4e7488]">Updated automatically via WHS logic.</p>
    </section>
  </main>
</Layout>