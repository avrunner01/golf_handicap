---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
---
<Layout title="Sign In | Golf Handicap">
  <main class="login-page">
    <div class="login-card">
      <div class="login-header">
        <h2>Golf Handicap Tracker</h2>
        <p>Sign in to track your scores</p>
      </div>

      <a href="/api/auth/google" 
         class="google-btn">
        <img src="/google-icon.png" class="google-icon" alt="Google" />
        Continue with Google
      </a>

      <div class="divider" aria-hidden="true">
        <span>Or continue with email</span>
      </div>

      <form id="signinForm" class="signin-form">
        <input type="email" name="email" placeholder="Email" class="field-input" required />
        <input type="password" name="password" placeholder="Password" class="field-input" required />
        <div class="action-grid">
          <a href="/" class="btn btn-cancel">Cancel</a>
          <button type="submit" class="btn btn-submit">Sign In</button>
        </div>
          <div class="forgot-wrap">
            <a href="/reset-password" class="forgot-link">Forgot Password?</a>
          </div>
        <div id="signinError" class="signin-error"></div>
      </form>
        <p class="signup-copy">
          Don't have an account? <a href="/signup" class="signup-link">Sign Up</a>
        </p>
        <script>
          // Remove 'code=' query param from URL if present
          if (window.location.search.includes('code=')) {
            window.history.replaceState({}, document.title, window.location.pathname);
          }

          document.getElementById('signinForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const errorDiv = document.getElementById('signinError');
            errorDiv.textContent = '';
            const res = await fetch('/api/auth/signin', {
              method: 'POST',
              body: formData
            });
            if (res.status === 200) {
              // Show a success message before redirecting
              const successDiv = document.createElement('div');
              successDiv.textContent = 'Sign in successful! Redirecting...';
              successDiv.className = 'signin-success';
              form.parentNode.insertBefore(successDiv, form.nextSibling);
              setTimeout(() => {
                window.location.href = '/dashboard';
              }, 1200);
            } else {
              const result = await res.json();
              errorDiv.textContent = result.error || 'Sign in failed.';
            }
          });
        </script>
    </div>
  </main>

  <style>
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: linear-gradient(145deg, #eaf8f1 0%, #f4fbff 100%);
    }

    .login-card {
      width: 100%;
      max-width: 28rem;
      background: #ffffff;
      border-radius: 0.9rem;
      box-shadow: 0 18px 40px rgba(12, 44, 28, 0.15);
      padding: 2.2rem;
      border: 1px solid #d2eadb;
    }

    .login-header {
      text-align: center;
      margin-bottom: 1.4rem;
    }

    .login-header h2 {
      margin: 0;
      color: #14532d;
      font-size: 1.85rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .login-header p {
      margin: 0.55rem 0 0;
      color: #4b5563;
      font-size: 0.95rem;
    }

    .google-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      border: 1px solid #d1d5db;
      color: #374151;
      text-decoration: none;
      padding: 0.62rem 0.95rem;
      border-radius: 0.5rem;
      background: #fff;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background-color 140ms ease;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }

    .google-btn:hover {
      background: #f9fafb;
    }

    .google-icon {
      width: 1.1rem;
      height: 1.1rem;
    }

    .divider {
      position: relative;
      margin: 1.5rem 0;
      text-align: center;
      color: #6b7280;
      font-size: 0.85rem;
    }

    .divider::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      border-top: 1px solid #d1d5db;
      transform: translateY(-50%);
    }

    .divider span {
      position: relative;
      background: #fff;
      padding: 0 0.5rem;
    }

    .signin-form {
      display: grid;
      gap: 0.75rem;
    }

    .field-input {
      width: 100%;
      border: 1px solid #d1d5db;
      border-radius: 0.5rem;
      padding: 0.62rem 0.7rem;
      font-size: 0.95rem;
      color: #0f172a;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .field-input:focus {
      outline: none;
      border-color: #16a34a;
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    }

    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    .btn {
      width: 100%;
      text-align: center;
      border-radius: 0.5rem;
      padding: 0.62rem 0.95rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      font-size: 0.95rem;
      transition: background-color 140ms ease;
    }

    .btn-cancel {
      background: #fff;
      color: #166534;
      border-color: #16a34a;
    }

    .btn-cancel:hover {
      background: #f0fdf4;
    }

    .btn-submit {
      background: #16a34a;
      color: #fff;
    }

    .btn-submit:hover {
      background: #15803d;
    }

    .forgot-wrap {
      text-align: right;
      margin-top: 0.25rem;
    }

    .forgot-link {
      color: #15803d;
      text-decoration: none;
      font-size: 0.85rem;
    }

    .forgot-link:hover {
      text-decoration: underline;
    }

    .signin-error {
      min-height: 1.1rem;
      margin-top: 0.15rem;
      color: #dc2626;
      font-weight: 600;
      font-size: 0.92rem;
    }

    .signin-success {
      margin-top: 0.5rem;
      text-align: center;
      color: #15803d;
      font-weight: 600;
      font-size: 0.92rem;
    }

    .signup-copy {
      text-align: center;
      margin-top: 1rem;
      font-size: 0.88rem;
      color: #4b5563;
    }

    .signup-link {
      color: #15803d;
      font-weight: 700;
      text-decoration: none;
    }

    .signup-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .login-card {
        padding: 1.3rem;
      }

      .action-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>