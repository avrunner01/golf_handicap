
---
export const prerender = false;

import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import { supabaseClient } from '../lib/supabase';
import { calculateHandicap } from '../lib/golfMath';

const supabase = supabaseClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

let profile = null;
let liveHandicap = null;
if (user) {
	const { data } = await supabase
		.from('profiles')
		.select('*')
		.eq('id', user.id)
		.single();
	profile = data;

	// Fetch rounds and calculate live handicap
	const { data: roundsData } = await supabase
		.from('rounds')
		.select('differential')
		.eq('profile_id', user.id);
	if (Array.isArray(roundsData)) {
		const differentials = roundsData
			.map(r => typeof r.differential === 'number' ? r.differential : Number(r.differential))
			.filter(d => !isNaN(d));
		if (differentials.length > 0) {
			liveHandicap = calculateHandicap(differentials);
		} else {
			liveHandicap = 'NH';
		}
	}
}
---

<Layout user={user}>
	 <section style="text-align:center; margin-top:3rem;">
		 <script is:inline>
			 const recoveryParams = new URLSearchParams(window.location.hash.slice(1));
			 const searchParams = new URLSearchParams(window.location.search);
			 const recoveryType = recoveryParams.get('type') || searchParams.get('type') || '';
			 // Also forward failed recovery links (expired/used) so the error can be shown there.
			 if (recoveryType.startsWith('recovery') || recoveryParams.has('access_token') || recoveryParams.has('code')
				 || searchParams.has('code') || recoveryParams.has('error') || searchParams.has('error')) {
				 window.location.replace(`/reset-password${window.location.search}${window.location.hash}`);
			 }

			 document.addEventListener('DOMContentLoaded', function () {
				 const msg = sessionStorage.getItem('handicapUpdated');
				 if (msg) {
					 sessionStorage.removeItem('handicapUpdated');
					 const alertDiv = document.createElement('div');
					 alertDiv.className = 'handicap-update-message bg-green-100 text-green-800 px-4 py-2 rounded mb-4';
					 alertDiv.innerText = msg;
					 document.body.prepend(alertDiv);
					 setTimeout(() => alertDiv.remove(), 3000);
				 }
			 });
		 </script>

		<h1>Golf Handicap Tracker</h1>
		{user && profile && profile.full_name && (
			<p class="text-xl font-bold text-green-800 mt-2 mb-2">Welcome, {profile.full_name}!</p>
		)}
		<p>Welcome to your personal golf handicap app. Track your rounds, view your stats, and improve your game!</p>
		<figure class="mx-auto my-8 w-full max-w-4xl overflow-hidden rounded-2xl shadow-lg">
			<img
				src="/67_chevelleaChatGPT Image Apr 30, 2026, 01_26_39 PM.png"
				alt="Blue 1967 Chevelle SS parked beside the ocean at sunset"
				class="block h-auto w-full"
			/>
			<figcaption class="bg-slate-900 px-4 py-2 text-sm text-white">1967 Chevelle SS</figcaption>
		</figure>

		{user && profile ? (
			<div class="max-w-md mx-auto my-8 p-6 bg-green-50 border border-green-200 rounded-xl shadow">
				   <!-- Welcome message removed as requested -->
				<p class="text-gray-700 mb-1"><strong>Username:</strong> {profile.username}</p>
				<p class="text-gray-700 mb-1"><strong>Handicap Index:</strong> {liveHandicap ?? 'NH'}</p>
				   <a href="/dashboard" class="inline-block mt-4 bg-green-600 text-white px-4 py-2 rounded">Go to Dashboard</a>
				{profile && profile.role === 'admin' && (
					<a href="/admin" class="inline-block mt-4 bg-green-700 text-white px-4 py-2 rounded ml-2 font-bold">Admin</a>
				)}
			</div>
		   ) : user && !profile ? (
			   <></>
		) : (
			<nav style="margin-top:2rem;">
				<a href="/add-round" style="margin-right:1.5rem;">Add Round</a>
				<a href="/dashboard" style="margin-right:1.5rem;">Dashboard</a>
				<a href="/login" style="margin-right:1.5rem;">Login</a>
				{user && profile && profile.role === 'admin' && (
					<a href="/admin" style="margin-right:1.5rem;color:#1a7f37;font-weight:bold;">Admin</a>
				)}
			</nav>
		)}
	</section>
</Layout>
